# ---------------------------------------------------------------------------
# repo-analyzer-skill environment configuration
# Copy to .env or export directly. Never commit real keys.
# ---------------------------------------------------------------------------

# GitHub API token (optional but strongly recommended: raises the API rate
# limit from 60 to 5000 requests/hour). Create one at
# https://github.com/settings/tokens — no scopes needed for public repos.
GITHUB_TOKEN=

# --- LLM provider (OpenAI-compatible endpoints) ----------------------------
# Any provider implementing the OpenAI chat completions API works, e.g.
#   OpenAI:    https://api.openai.com/v1
#   DeepSeek:  https://api.deepseek.com/v1
#   Moonshot:  https://api.moonshot.cn/v1
#   Qwen:      https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Runtime ----------------------------------------------------------------
# Report language: en (default) | zh
REPORT_LANGUAGE=en
# Where analysis artifacts land: <OUTPUT_DIR>/repos/<owner>/<repo>/...
OUTPUT_DIR=output
# Token budget for code samples fed to the LLM reasoning phase
TOKEN_BUDGET=40000
LOG_LEVEL=INFO
